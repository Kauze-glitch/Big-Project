.form-step { display: none; border: 0; padding: 0; margin: 22px 0 0; min-width: 0; animation: step-in 240ms ease-out both; }
.form-step.is-active { display: block; }
.form-step legend { max-width: 15ch; padding: 0; margin: 0 0 18px; font-family: var(--font-display); font-size: clamp(2.3rem, 4vw, 4.5rem); font-weight: 700; line-height: .94; letter-spacing: -.02em; }
.helper { max-width: 48ch; margin: 0 0 32px; color: var(--muted); }
.field-label { display: block; margin: 0 0 8px; font-size: var(--step-small); font-weight: 500; }
input[type="text"], textarea { width: 100%; border: 3px solid transparent; border-radius: 0; background: white; color: var(--ink); padding: 16px 18px; min-height: 56px; outline: none; }
input[type="text"]:focus, textarea:focus { border-color: var(--accent); }
textarea { resize: vertical; min-height: 150px; }
.field-error { min-height: 22px; margin: 8px 0 0; color: #7d1419; font-size: var(--step-small); font-weight: 500; }
.choice-stack { display: grid; gap: 10px; }
.choice { display: block; cursor: pointer; }
.choice input, .segmented input { position: absolute; opacity: 0; pointer-events: none; }
.choice span { display: flex; min-height: 68px; flex-direction: column; justify-content: center; border: 3px solid transparent; background: white; padding: 12px 16px; transition: transform 140ms ease, border-color 140ms ease, background-color 140ms ease; }
.choice small { color: var(--muted); font-size: var(--step-small); }
.choice:hover span { transform: translateX(4px); }
.choice input:focus-visible + span, .segmented input:focus-visible + span { outline: 4px solid var(--mustard); outline-offset: 3px; }
.choice input:checked + span { border-color: var(--ink); background: var(--mustard); }
.selector-group + .selector-group { margin-top: 20px; }
.segmented { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 8px; }
.segmented-wrap { grid-template-columns: repeat(4, minmax(0,1fr)); }
.segmented label { cursor: pointer; }
.segmented span { display: grid; min-height: 52px; place-items: center; background: white; border: 3px solid transparent; padding: 8px 10px; text-align: center; font-weight: 500; }
.segmented input:checked + span { background: var(--ink); color: white; }
.textarea-meta { display: flex; justify-content: space-between; gap: 20px; align-items: flex-start; }
.textarea-meta > span { margin-top: 8px; color: var(--muted); font-size: var(--step-small); font-variant-numeric: tabular-nums; }
.form-actions { display: flex; justify-content: space-between; gap: 12px; margin-top: auto; padding-top: 30px; }
.form-actions .button { min-width: 132px; }

.success-panel { grid-column: 2; background: var(--mustard); color: var(--ink); padding: clamp(34px, 5vw, 70px); }
.success-mark { display: grid; width: 72px; height: 72px; place-items: center; margin: 0 0 32px; border-radius: 50%; background: var(--ink); color: white; font-size: 2rem; }
.success-panel h3 { margin: 0 0 18px; font-family: var(--font-display); font-size: clamp(3rem, 5.5vw, 6rem); line-height: .88; letter-spacing: -.02em; }
.success-panel > p:not(.success-mark) { max-width: 48ch; }
.admin-links { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 10px; margin-top: 34px; }
.admin-link { display: flex; min-height: 84px; flex-direction: column; justify-content: center; background: var(--ink); color: white; padding: 14px 18px; text-decoration: none; transition: transform 140ms ease; }
.admin-link:hover { transform: translateY(-3px); }
.admin-link span { font-size: var(--step-small); }
.admin-link strong { font-family: var(--font-display); font-size: 1.65rem; line-height: 1.1; }

.footer { min-height: 90svh; position: relative; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; background: var(--maroon); color: white; padding: clamp(54px, 8vw, 110px) clamp(20px, 3vw, 42px) 0; }
.footer-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 40px; position: relative; z-index: 2; }
.footer h2 { max-width: 9ch; margin: 0 0 18px; font-family: var(--font-display); font-size: var(--step-head); line-height: .88; }
.footer p { margin: 0; }
.footer-contacts { display: grid; gap: 12px; }
.credits { position: relative; z-index: 2; max-width: 88ch; margin-top: auto !important; padding-bottom: 18px; font-size: var(--step-small); line-height: 1.45; }
.footer-word { margin: auto 0 -8vw !important; font-family: var(--font-display); font-size: min(32vw, 34rem); font-weight: 700; line-height: .72; letter-spacing: -.055em; white-space: nowrap; transform: translateX(-1.5vw); }

@keyframes line-in { from { transform: translateY(115%); } to { transform: translateY(0); } }
@keyframes step-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

@media (max-width: 820px) {
  .hero { min-height: auto; padding-bottom: 0; }
  .hero-grid { min-height: auto; grid-template-columns: 1fr; }
  .hero-title-wrap { order: 1; min-height: 68svh; justify-content: flex-start; padding-top: 11vh; }
  .hero-title { font-size: clamp(4.7rem, 22vw, 8rem); line-height: .82; }
  .hero-copy { order: 2; gap: 22px; padding: 28px 0 44px; }
  .hero-copy p { max-width: 31ch; }
  .hero-copy .button { width: 100%; }
  .match-strip { bottom: 18%; }
  .court-art { width: 82vw; right: -32%; bottom: -4%; }
  .ball-mark { width: 72px; height: 72px; }
  .manifesto { padding-block: 72px; }
  .manifesto h2 { margin-bottom: 34px; }
  .manifesto p { margin-left: 0; }
  .photo-strip { grid-template-columns: repeat(2, minmax(0,1fr)); min-height: 460px; }
  .photo-frame { height: 230px; }
  .signup-heading { grid-template-columns: 1fr; gap: 20px; margin-bottom: 34px; }
  .coupon { grid-template-columns: 1fr; min-height: 0; }
  .coupon::before, .coupon::after { top: 274px; bottom: auto; left: auto; }
  .coupon::before { left: -22px; }
  .coupon::after { right: -22px; }
  .coupon-side { min-height: 296px; padding: 30px 24px 34px; }
  .coupon-side::after { top: auto; left: 28px; right: 28px; bottom: -2px; border-left: 0; border-bottom: 5px dotted var(--bg); }
  .coupon-side h3 { font-size: clamp(3.5rem, 17vw, 5.8rem); }
  .join-form { padding: 34px 22px 26px; min-height: 540px; }
  .form-step legend { font-size: clamp(2.5rem, 12vw, 4.2rem); }
  .segmented-wrap { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .success-panel { grid-column: 1; padding: 38px 22px 44px; }
  .admin-links { grid-template-columns: 1fr; }
  .footer { min-height: 72svh; }
  .footer-top { flex-direction: column; }
  .footer-word { margin-bottom: -4vw !important; font-size: 44vw; }
  .credits { padding-bottom: 8px; }
}

@media (max-width: 430px) {
  .match-strip { gap: 10px; padding: 11px 12px; }
  .match-strip strong { font-size: 1.65rem; }
  .signup-section { padding-inline: 20px; }
  .coupon { border-radius: 22px; }
  .progress-copy { font-size: .8rem; }
  .form-actions .button { min-width: 0; flex: 1; padding-inline: 12px; }
}

.js [data-reveal] { opacity: 0; transform: translateY(22px); }
.js [data-reveal].is-visible { opacity: 1; transform: translateY(0); transition: opacity 460ms ease, transform 460ms cubic-bezier(.2,.8,.2,1); }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
