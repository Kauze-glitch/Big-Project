 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Phiên truy cập ứng dụng do máy chủ cấp sau OTP, không phải bản sao mật khẩu hoặc access token Auth. Chỉ máy chủ truy cập; token ngẫu nhiên không chứa số định danh hoặc dữ liệu cá nhân. Mọi API công dân kiểm tra phiên, Auth session, hạn dùng, trạng thái tài khoản và phiên bản bảo mật. Không tin cờ otp_verified do trình duyệt tự gửi; xác minh OTP và cấp phiên cần tiêu thụ thử thách nguyên tử. Chốt cách chuyển token/cookie và cấu hình CORS phù hợp GitHub Pages trước triển khai; không truyền token trong URL.'
}

Table NHAT_KY_THAO_TAC {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 actor_user_id uuid [ref: > auth.users.id, note: 'Cho trống nếu tác vụ hệ thống']
 actor_label text [not null, note: 'Nhãn vai trò tại thời điểm thực hiện']
 hanh_dong text [not null, note: 'Loại thao tác']
 doi_tuong_loai text [not null, note: 'Tên loại đối tượng']
 doi_tuong_id uuid [note: 'Mã đối tượng; liên kết đa hình có kiểm tra tại máy chủ']
 truoc_thay_doi jsonb [note: 'Chỉ các trường cho phép ghi nhật ký']
 sau_thay_doi jsonb [note: 'Chỉ các trường cho phép ghi nhật ký']
 request_id uuid [not null, note: 'Đối chiếu cùng một nghiệp vụ']
 thoi_diem timestamptz [not null, note: 'Thời gian máy chủ']
 Note: 'Dấu vết tạo/sửa hồ sơ, cấp/khóa tài khoản, nhập/xuất; chỉ máy chủ ghi. Không lưu mật khẩu, token, mã OTP hoặc bản sao tệp trong nhật ký. Chỉ thêm mới qua dịch vụ máy chủ; thành viên đọc theo quyền, công dân không đọc nhật ký nội bộ. Giữ lịch sử khi ngừng tài khoản; dùng actor_label để không mất ngữ cảnh.'
}

Table DOT_NHAP_DU_LIEU {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 nguoi_nhap_id uuid [not null, ref: > THANH_VIEN_DU_AN.id, note: 'Thành viên phụ trách']
 loai_du_lieu text [not null, note: 'cong_dan / ho_gia_dinh / cu_tru']
 ten_tep text [not null, note: 'Tên file nguồn']
 tep_nguon_path text [note: 'Bản lưu riêng tư nếu cần']
 phien_ban_mau text [not null, note: 'Phiên bản định dạng import']
 che_do text [not null, note: 'them_moi / cap_nhat']
 trang_thai text [not null, note: 'dang_kiem_tra / can_sua / san_sang / dang_nhap / hoan_thanh / that_bai / da_huy']
 idempotency_key uuid [not null, unique, note: 'Chống nhập lặp khi bấm lại hoặc thử lại']
 bat_dau_luc timestamptz [not null, note: 'Thời điểm bắt đầu']
 ket_thuc_luc timestamptz [note: 'Khi kết thúc']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Quản lý xem trước và xác nhận nhập file vào bảng nghiệp vụ. Xem trước không thay đổi hồ sơ chính; kiểm tra trùng trước và kiểm tra lại lúc xác nhận nhập. Bản đầu dùng giao dịch tất cả hoặc không có gì cho một đợt đã hợp lệ, có giới hạn số dòng. Chỉ cập nhật theo khóa định danh đã xác nhận; không ghép người chỉ bằng họ tên. Tổng số dòng thành công/lỗi tính từ DONG_NHAP.'
}

Table DONG_NHAP {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 dot_nhap_id uuid [not null, ref: > DOT_NHAP_DU_LIEU.id, note: 'Đợt nhập']
 so_dong integer [not null, note: 'Số dòng trong file']
 du_lieu_goc jsonb [not null, note: 'Dữ liệu để xem trước; chỉ giữ theo thời hạn quy định của đồ án']
 du_lieu_chuan_hoa jsonb [note: 'Giá trị đã kiểm tra']
 loi_kiem_tra jsonb [note: 'Danh sách lỗi theo tên trường']
 trang_thai text [not null, note: 'hop_le / co_loi / da_nhap']
 cong_dan_id uuid [ref: > CONG_DAN.id, note: 'Kết quả nếu nhập công dân']
 ho_id uuid [ref: > HO_GIA_DINH.id, note: 'Kết quả nếu nhập hộ']
 cu_tru_id uuid [ref: > CU_TRU.id, note: 'Kết quả nếu nhập cư trú']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Báo lỗi đến từng dòng và liên kết kết quả sau khi xác nhận. UNIQUE(dot_nhap_id, so_dong). Trước nhập chưa có khóa kết quả. Sau nhập đúng một khóa kết quả, phù hợp loại_du_lieu của đợt nhập. Không lưu dữ liệu staging vô thời hạn; khi dọn staging vẫn giữ metadata và nhật ký cần thiết.'
}

