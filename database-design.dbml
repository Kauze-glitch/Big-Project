// Bản thiết kế logic để duyệt, chưa triển khai. auth.users là bảng của dịch vụ Auth hiện có.
Table auth.users {
 id uuid [pk]
}

Table DON_VI_HC {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 ma_don_vi text [not null, unique, note: 'Mã nghiệp vụ']
 ten_don_vi text [not null, note: 'Tên đơn vị']
 cap_hanh_chinh text [not null, note: 'Mã cấp trong danh mục được nhóm thống nhất']
 don_vi_cha_id uuid [ref: > DON_VI_HC.id, note: 'Để trống với đơn vị gốc']
 hieu_luc_tu date [not null, note: 'Ngày bắt đầu sử dụng']
 hieu_luc_den date [note: 'Ngày kết thúc sử dụng']
 trang_thai text [not null, note: 'hoat_dong / ngung_hoat_dong']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Cây đơn vị quản lý và địa bàn; lưu đơn vị ngừng hoạt động để giữ lịch sử. Không cho đơn vị làm cha của chính nó hoặc tạo chu trình nhiều cấp. Mã không tái sử dụng cho một đơn vị khác. Đổi tên/địa giới không tự sửa địa chỉ lịch sử. Không xóa đơn vị đã được tham chiếu; dùng trạng thái và thời gian hiệu lực.'
}

Table CONG_DAN {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 so_dinh_danh varchar(12) [unique, note: 'Chuỗi 12 chữ số; cho trống khi hồ sơ đang chờ bổ sung']
 ho_ten_khai_sinh text [not null, note: 'Họ tên đầy đủ, Unicode NFC']
 ten_goi_khac text [note: 'Tên gọi khác']
 ngay_sinh date [note: 'Chỉ nhập ngày chính xác khi có căn cứ']
 nam_sinh smallint [note: 'Dùng khi chỉ biết năm; không tự bịa ngày 01/01']
 do_chinh_xac_ngay_sinh text [not null, note: 'day_du / chi_nam / chua_ro']
 gioi_tinh text [not null, note: 'nam / nu / khac / chua_xac_dinh']
 noi_sinh text [note: 'Nơi sinh theo hồ sơ']
 noi_dang_ky_khai_sinh text [note: 'Khác với nơi sinh và quê quán']
 que_quan text [note: 'Quê quán theo hồ sơ']
 dan_toc text [note: 'Chọn từ danh mục']
 ton_giao text [note: 'Chọn từ danh mục; chưa rõ khác với không tôn giáo']
 nghe_nghiep text [note: 'Nghề nghiệp hiện tại']
 so_dien_thoai_lien_he text [note: 'Số liên hệ; không tự thay số nhận OTP']
 email_lien_he text [note: 'Email liên hệ']
 tinh_trang_ca_nhan text [not null, note: 'con_song / da_chet / mat_tich / chua_xac_minh']
 ngay_ghi_nhan_tinh_trang date [note: 'Ngày gắn với tình trạng cá nhân']
 trang_thai_ho_so text [not null, note: 'nhap / da_xac_nhan / luu_tru']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Thông tin nhân thân gốc; độc lập với việc có thẻ, có hộ hoặc được cấp tài khoản. Số định danh không phải khóa chính; mã UUID nội bộ giữ ổn định khi hiệu chỉnh thông tin. Ngày sinh không ở tương lai. Chỉ một cách biểu diễn ngày sinh được sử dụng theo độ chính xác. Không bắt hồ sơ công dân phải có tài khoản, thẻ hoặc hộ ngay khi tạo. Thông tin quốc tịch, cư trú, hộ, quan hệ và hôn nhân lấy từ các bảng liên quan, không lưu thêm bản sao tại đây.'
}

Table QUOC_TICH_CONG_DAN {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Công dân']
 ma_quoc_gia text [not null, note: 'Mã từ danh mục quốc gia']
 tu_ngay date [note: 'Ngày bắt đầu nếu biết']
 den_ngay date [note: 'Ngày kết thúc nếu có']
 ghi_chu text [note: 'Nguồn hoặc ghi chú']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Cho phép một người có nhiều quốc tịch mà không ghép nhiều giá trị vào một ô. Không lặp một quốc tịch đang hiệu lực cho cùng một công dân. Không có bản ghi nghĩa là chưa cập nhật; không tự kết luận không quốc tịch.'
}

Table CU_TRU {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Công dân']
 loai_cu_tru text [not null, note: 'thuong_tru / tam_tru / noi_o_hien_tai']
 don_vi_hc_id uuid [not null, ref: > DON_VI_HC.id, note: 'Địa bàn tại thời điểm ghi nhận']
 dia_chi_chi_tiet text [not null, note: 'Số nhà, đường, thôn hoặc tổ dân phố']
 dia_chi_day_du_tai_thoi_diem text [not null, note: 'Bản chụp tên địa chỉ để giữ lịch sử']
 tu_ngay date [not null, note: 'Bắt đầu hiệu lực']
 den_ngay date [note: 'Kết thúc; trống là còn hiệu lực']
 trang_thai text [not null, note: 'cho_xac_nhan / da_xac_nhan / huy']
 ho_so_nguon_id uuid [ref: > HO_SO_YEU_CAU.id, note: 'Yêu cầu làm căn cứ, nếu có']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Phân biệt thường trú, tạm trú và nơi ở hiện tại; theo dõi thay đổi theo thời gian. Quy ước đồ án: không có hai khoảng cư trú đã xác nhận chồng lấn cho cùng người và cùng loại. Thường trú và tạm trú được phép đồng thời vì khác loại. Khi chuyển nơi cư trú: kết thúc bản ghi cũ và thêm bản ghi mới trong cùng giao dịch.'
}

Table HO_GIA_DINH {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 ma_ho text [not null, unique, note: 'Mã hộ trong hệ thống']
 so_ho_so_cu_tru text [unique, note: 'Số hồ sơ nghiệp vụ nếu được nhập']
 don_vi_hc_id uuid [not null, ref: > DON_VI_HC.id, note: 'Đơn vị quản lý']
 dia_chi text [not null, note: 'Địa chỉ hộ hiện tại']
 ngay_lap date [not null, note: 'Ngày tạo hộ']
 trang_thai text [not null, note: 'nhap / hoat_dong / da_giai_the']
 ngay_giai_the date [note: 'Khi hộ kết thúc']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Thay tên kỹ thuật HO_KHAU để mô tả nhóm hộ; không giả định luôn có một sổ giấy. Không lưu ma_chu_ho ở bảng này: chủ hộ được xác định bởi THANH_VIEN_HO để tránh vòng khóa ngoại và hai nguồn thông tin. Hộ nháp được phép chưa có thành viên; hộ hoạt động phải có đúng một chủ hộ còn hiệu lực.'
}

Table THANH_VIEN_HO {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 ho_id uuid [not null, ref: > HO_GIA_DINH.id, note: 'Hộ']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Thành viên']
 quan_he_voi_chu_ho text [not null, note: 'chu_ho / vo_chong / con / cha_me / khac']
 tu_ngay date [not null, note: 'Bắt đầu thuộc hộ']
 den_ngay date [note: 'Kết thúc thuộc hộ']
 ly_do_thay_doi text [note: 'Lý do chuyển hộ hoặc đổi quan hệ']
 ho_so_nguon_id uuid [ref: > HO_SO_YEU_CAU.id, note: 'Yêu cầu làm căn cứ']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Liên kết công dân với hộ và giữ lịch sử chuyển hộ, đổi chủ hộ. Quy ước phạm vi đồ án: một người không thuộc hai hộ đang hiệu lực cùng lúc. Một hộ không có hai chủ hộ trong cùng khoảng thời gian. Đổi chủ hộ, chuyển hộ và giải thể thực hiện trong giao dịch; kiểm tra đúng một chủ hộ ở thời điểm hoàn tất. Quan hệ với chủ hộ không thay thế quan hệ nhân thân.'
}

Table THE_CAN_CUOC {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Chủ thể']
 loai_giay_to text [not null, note: 'can_cuoc / cccd / cmnd']
 so_tren_giay_to text [not null, note: 'Số ghi trên giấy tờ, giữ số 0 đầu']
 ngay_cap date [not null, note: 'Ngày cấp của lần này']
 noi_cap text [not null, note: 'Cơ quan hoặc nơi cấp']
 ngay_het_han date [note: 'Nếu có thời hạn xác định']
 trang_thai text [not null, note: 'con_hieu_luc / het_han / da_thay_the / mat / thu_hoi']
 thay_the_giay_to_id uuid [ref: > THE_CAN_CUOC.id, note: 'Thẻ hoặc giấy tờ trước đó']
 phien_ban_mau text [not null, note: 'cccd / can_cuoc / cmnd; chọn bố cục hiển thị tương ứng']
 thong_tin_tren_the jsonb [not null, note: 'Bản chụp các thông tin tại thời điểm cấp; chỉ các khóa được cho phép']
 ly_do_cap text [not null, note: 'cap_lan_dau / cap_doi / cap_lai']
 ngay_thu_hoi date [note: 'Nếu thẻ bị thu hồi hoặc bị hủy']
 ly_do_ngung_hieu_luc text [note: 'Lý do thay thế hoặc thu hồi']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Nguồn dữ liệu hiển thị thẻ trong hồ sơ điện tử: một công dân có lịch sử nhiều lần cấp, với thẻ hiện hành được chọn theo hiệu lực. Không đặt UNIQUE riêng trên số giấy tờ: các lần cấp đổi có thể dùng cùng số. Kiểm tra trùng theo loại + số + ngày cấp và chủ thể. Một số định danh không được gán cho hai công dân; nếu lưu số định danh trên thẻ thì phải khớp hồ sơ công dân. Giấy tờ thay thế phải thuộc cùng người, không tự tham chiếu hoặc tạo chu trình. Ngày hết hạn, nếu có, không trước ngày cấp. Ảnh chân dung và hình mặt trước/mặt sau là các TEP_DINH_KEM gắn với thẻ này; phân biệt bằng vai_tro_tep. Không đặt đường dẫn công khai trong hồ sơ. Bản chụp thong_tin_tren_the giữ nguyên theo lần cấp, khác với hồ sơ hiện tại có thể thay đổi. API trả riêng thông tin trên thẻ và thông tin hiện tại, không trộn hai nguồn. Màn hình chỉ hiển thị thẻ khi tài khoản đã qua đủ hai bước, tài khoản đang hoạt động và thẻ đúng chủ thể. Thẻ hết hạn/mất/thu hồi vẫn xem lịch sử nhưng không gắn nhãn đang có hiệu lực. Với bố cục CCCD hoặc căn cước: thẻ hiện hành là bản ghi con_hieu_luc, có ngay_cap không ở tương lai và chưa hết hạn; nếu có hai bản ghi cạnh tranh thì yêu cầu thành viên giải quyết, không tự chọn tùy ý.'
}

Table QUAN_HE_NHAN_THAN {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Người có hồ sơ đang xét']
 nguoi_lien_quan_id uuid [ref: > CONG_DAN.id, note: 'Liên kết nếu người thân có hồ sơ']
 loai_quan_he text [not null, note: 'cha / me / nguoi_dai_dien']
 ho_ten_ngoai_he_thong text [note: 'Chỉ dùng khi chưa có hồ sơ người liên quan']
 so_dinh_danh_ngoai_he_thong varchar(12) [note: 'Nếu biết và chưa liên kết']
 quoc_tich_ngoai_he_thong text [note: 'Nếu chưa có hồ sơ']
 tu_ngay date [note: 'Ngày bắt đầu nếu biết']
 den_ngay date [note: 'Kết thúc quan hệ đại diện nếu có']
 can_cu text [note: 'Thông tin giấy tờ làm căn cứ']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Cha/mẹ và đại diện pháp luật được quản lý độc lập với hộ; vợ/chồng nằm ở bảng hôn nhân. Phải có người liên quan hoặc họ tên ngoài hệ thống; không có cả liên kết và bản sao ngoài hệ thống làm nguồn song song. Không tự làm cha/mẹ hoặc đại diện cho chính mình; quan hệ cha mẹ không tạo chu trình tổ tiên. Quan hệ con được truy ngược từ cha/mẹ, không lưu thêm dòng đối xứng. Khi liên kết hồ sơ mới cho người thân, cập nhật quan hệ thay vì nhân đôi bản ghi.'
}

Table TINH_TRANG_HON_NHAN {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Công dân']
 tinh_trang text [not null, note: 'chua_ket_hon / dang_ket_hon / da_ly_hon / goa / chua_xac_minh']
 vo_chong_id uuid [ref: > CONG_DAN.id, note: 'Vợ/chồng nếu có hồ sơ']
 ho_ten_vo_chong_ngoai text [note: 'Nếu chưa có hồ sơ liên kết']
 so_dinh_danh_vo_chong_ngoai varchar(12) [note: 'Nếu biết']
 tu_ngay date [not null, note: 'Ngày bắt đầu hiệu lực được ghi nhận']
 den_ngay date [note: 'Ngày kết thúc']
 giay_to_can_cu_id uuid [ref: > GIAY_TO_HO_TICH.id, note: 'Giấy tờ căn cứ, nếu có']
 created_at timestamptz [not null, note: 'Thời điểm tạo, máy chủ đặt']
 updated_at timestamptz [not null, note: 'Thời điểm cập nhật, máy chủ đặt']
 created_by uuid [ref: > auth.users.id, note: 'Người tạo; trống nếu tác vụ hệ thống']
 updated_by uuid [ref: > auth.users.id, note: 'Người cập nhật cuối']
 row_version integer [not null, note: 'Bắt đầu 1, tăng khi cập nhật để chống ghi đè']
 Note: 'Lưu trạng thái theo thời gian; không lặp tình trạng hiện tại trong CONG_DAN. Không chồng lấn khoảng trạng thái của cùng một công dân. Chưa có dữ liệu hiển thị Chưa cập nhật, không suy ra độc thân. Không liên kết vợ/chồng với chính mình; dùng liên kết hoặc thông tin ngoài hệ thống, không cả hai. Nếu cả hai người có hồ sơ, cập nhật hai phía đồng bộ bằng nghiệp vụ máy chủ; kiểm tra mâu thuẫn vợ/chồng đang hiệu lực.'
}

Table GIAY_TO_HO_TICH {
 id uuid [pk, note: 'Mã nội bộ, tự sinh']
 cong_dan_id uuid [not null, ref: > CONG_DAN.id, note: 'Hồ sơ sở hữu bản ghi giấy tờ']
 loai_giay_to text [not null, note: 'khai_sinh / ket_hon / khai_tu / khac']
 so_giay_to text [not null, note: 'Số trên giấy tờ']
 so_quyen text [note: 'Quyển đăng ký nếu có']
 ngay_cap date [not null, note: 'Ngày cấp']
 co_quan_cap text [not null, note: 'Cơ quan cấp']
 trang_thai text [not null, note: 'hieu_luc / da_thay_the / huy']
 ghi_chu text [note: 'Thông tin bổ sung']
